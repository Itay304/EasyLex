@startuml 09_Seq_Quiz
title זרימת חידון — Quiz + Gamification

skinparam defaultFontSize 13
skinparam sequence {
  ArrowColor #1565C0
  ParticipantBackgroundColor #E3F2FD
  ParticipantBorderColor #1565C0
  NoteBackgroundColor #FFFDE7
  NoteBorderColor #F9A825
}

actor "משתמש" as User
participant "QuizFragment" as QF
participant "MyWordsViewModel" as VM
participant "Room DB" as DB
participant "GamificationEngine" as GE
participant "Firestore" as FS

QF -> VM : getAllWords().observe()
VM -> DB : LiveData<List<Word>>
DB --> QF : allWords

QF -> QF : buildSession()
note right : 60% Mastery 0-2\n20% 0 attempts\n20% Mastery 3-5

loop 20 שאלות
  QF --> User : שאלה + 4 אפשרויות
  User -> QF : לוחץ

  alt נכון
    QF -> QF : correctAttempts++
    QF -> VM : update(word)
    VM -> DB : UPDATE
    QF -> GE : onCorrectAnswer(before, after)
    GE -> GE : +10 XP\n(+100 אם mastery 4→5)
    GE -> FS : update(totalXp, level)
    QF --> User : +10 XP animation
    QF -> QF : Handler.postDelayed(1s)
  else שגוי
    QF -> QF : totalAttempts++\nerrorInQuiz=true
    QF -> VM : update(word)
  end
end

QF -> GE : onModuleComplete() +50 XP
QF --> User : showResultDialog()\nOvershootInterpolator animation

@enduml
