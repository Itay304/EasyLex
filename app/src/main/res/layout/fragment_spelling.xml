<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Back navigation toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="אלוף האיות"
        app:titleCentered="false" />

    <!-- Spelling content (padding moved here from root) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- פרוגרס בר -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/spellingProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:trackThickness="8dp"
            app:trackCornerRadius="4dp"
            app:indicatorColor="@color/turquoise_accent" />

        <TextView
            android:id="@+id/tvSpellingCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 10"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:textColor="#999999"/>

        <!-- אזור השאלה -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8F9FA">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHebrewPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="תרגום"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <ImageButton
                    android:id="@+id/btnRepeatAudio"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="@color/green_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- אזור הקלט -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="הקלד את המילה באנגלית"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEnglishInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:textSize="20sp"
                android:textAlignment="center"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- הודעת שגיאה גדולה — מוסתרת עד שהמשתמש טועה -->
        <TextView
            android:id="@+id/tvSpellingError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFF3E0"
            android:padding="16dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#E65100"
            android:textAlignment="center"
            android:gravity="center"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckSpelling"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="בדוק תשובה"
            android:textSize="18sp"
            app:cornerRadius="16dp"/>

    </LinearLayout>

</LinearLayout>
