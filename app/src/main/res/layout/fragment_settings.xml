<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grey_light">

    <!-- Toolbar with back navigation -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/green_primary"
        app:title="הגדרות"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ══════════════════════════════════════════ -->
            <!-- Section: Account                          -->
            <!-- ══════════════════════════════════════════ -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="חשבון"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="6dp"
                android:gravity="right" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Name row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">

                        <!-- Edit name button (pencil) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditName"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:icon="@drawable/ic_edit"
                            app:iconTint="@color/green_primary"
                            android:contentDescription="ערוך שם" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="right">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="שם משתמש"
                                android:textSize="12sp"
                                android:textColor="@color/grey_text" />

                            <TextView
                                android:id="@+id/tvSettingsName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/black_soft" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="12dp"
                            android:src="@drawable/ic_profile_placeholder"
                            android:scaleType="centerCrop" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE" />

                    <!-- Email row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layoutDirection="ltr"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp">

                        <TextView
                            android:id="@+id/tvSettingsEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="—"
                            android:textSize="14sp"
                            android:textColor="@color/gray_dark"
                            android:gravity="left" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="אימייל"
                            android:textSize="12sp"
                            android:textColor="@color/grey_text"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════ -->
            <!-- Section: Learning                         -->
            <!-- ══════════════════════════════════════════ -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="למידה"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="6dp"
                android:gravity="right" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Daily goal header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layoutDirection="ltr"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDailyGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 מילים"
                            app:chipBackgroundColor="@color/turquoise_accent"
                            android:textColor="@color/white"
                            app:chipMinHeight="28dp"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="מטרה יומית"
                            android:textSize="15sp"
                            android:textColor="@color/black_soft"
                            android:gravity="right" />
                    </LinearLayout>

                    <!-- Daily goal slider (5, 10, 15, 20) -->
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderDailyGoal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="5"
                        android:valueTo="20"
                        android:stepSize="5"
                        android:value="10"
                        app:trackColor="#DDDDDD"
                        app:thumbColor="@color/turquoise_accent"
                        app:trackColorActive="@color/turquoise_accent"
                        android:layout_marginBottom="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="12dp" />

                    <!-- TTS toggle row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchTts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:thumbTint="@color/turquoise_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="right">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="קריאה קולית"
                                android:textSize="15sp"
                                android:textColor="@color/black_soft" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="הפעל הגייה אנגלית של מילים"
                                android:textSize="12sp"
                                android:textColor="@color/grey_text" />
                        </LinearLayout>
                    </LinearLayout>


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════ -->
            <!-- Section: Data                             -->
            <!-- ══════════════════════════════════════════ -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="נתונים"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="6dp"
                android:gravity="right" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Sync now -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncNow"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="סנכרן נתונים עם הענן"
                        android:textColor="@color/green_primary"
                        app:strokeColor="@color/green_primary"
                        app:icon="@drawable/ic_download"
                        app:iconTint="@color/green_primary"
                        android:layout_marginBottom="12dp" />

                    <!-- Clear personal words -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearPersonalWords"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="נקה רשימה אישית"
                        android:textColor="#E65100"
                        app:strokeColor="#E65100"
                        android:layout_marginBottom="12dp" />

                    <!-- Reset progress (danger) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetProgress"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="אפס התקדמות (XP / רמה / רצף)"
                        android:textColor="#D32F2F"
                        app:strokeColor="#D32F2F"
                        app:iconTint="#D32F2F" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════════ -->
            <!-- Section: About                            -->
            <!-- ══════════════════════════════════════════ -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="אודות"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="6dp"
                android:gravity="right" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- App name + version row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/tvSettingsVersion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1.1"
                            android:textSize="14sp"
                            android:textColor="@color/gray_dark"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="גרסה"
                            android:textSize="15sp"
                            android:textColor="@color/black_soft" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="12dp" />

                    <!-- App description row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="EasyLex"
                            android:textSize="14sp"
                            android:textColor="@color/gray_dark"
                            android:gravity="start" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="אפליקציה"
                            android:textSize="15sp"
                            android:textColor="@color/black_soft" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
