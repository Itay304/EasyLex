<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ההתקדמות שלי"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/green_dark"
            android:layout_marginBottom="16dp" />

        <!-- ── Rank card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/green_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRankEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱"
                    android:textSize="40sp"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRankTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="מתחיל"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tvRankDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="המסע זה עתה החל!"
                        android:textSize="13sp"
                        android:textColor="#E0FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Gamification card: Level + XP + Streak ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Row: Level badge + Streak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvLevel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="רמה 1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_primary" />

                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ימים ברצף 🔥"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/turquoise_accent" />

                </LinearLayout>

                <!-- XP total -->
                <TextView
                    android:id="@+id/tvXPPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 XP"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_primary"
                    android:layout_marginBottom="8dp" />

                <!-- Progress bar to next level -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:trackThickness="10dp"
                    app:trackCornerRadius="5dp"
                    app:indicatorColor="@color/turquoise_accent"
                    app:trackColor="#EEEEEE"
                    android:indeterminate="false" />

                <TextView
                    android:id="@+id/tvXpToNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100 XP לרמה הבאה"
                    android:textSize="13sp"
                    android:textColor="#888888" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Mastery circle ── -->
        <RelativeLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="20dp">

            <ProgressBar
                android:id="@+id/progressMasteryCircular"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:progressDrawable="@drawable/circular_progress" />

            <TextView
                android:id="@+id/tvMasteryScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="0%"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/turquoise_accent" />

        </RelativeLayout>

        <!-- ── Stats card: mastered words + accuracy ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="מילים שנכבשו:"
                    android:textColor="#888888" />

                <TextView
                    android:id="@+id/tvTotalWordsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 מתוך 0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginVertical="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="דיוק כללי בתרגול:"
                    android:textColor="#888888" />

                <TextView
                    android:id="@+id/tvAccuracyPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
